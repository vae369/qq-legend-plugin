            mapPath = LegendFilePath.MapPath + "MapInfo.txt";
            mapMonInfo = LegendFilePath.MapPath + "MapMonInfo.txt";

            string stdPath = LegendFilePath.Mud2Path + "stditem.txt";
            string res = FileHelper.ReadTxt(stdPath);
            stdDBList = Api.JsonDeserialize<List<StditemDB>>(res);//读取所有物品数据

            if (user.KillMon != null)
            {
                listMonsterAttack = GetMonsterAttackIMG(user.KillMon.MonID);// 取怪物攻击图片
                listMonsterAttacked = GetMonsterAttackedIMG(user.KillMon.MonID);// 取怪物被打图片
                listMonsterDeath = GetMonsterDeathIMG(user.KillMon.MonID);// 取怪物死亡图片
                listMonsterStand = GetMonsterStandIMG(user.KillMon.MonID);// 取怪物站立图片
            }


            WarriorList1 = GetWaList1();//男战图片集合
            WizardList1 = GetWiList1();//男法图片集合
            TaoistList1 = GetTaList1();//道士列表
            WarriorList2 = GetWaList2();//女战图片集合
            WizardList2 = GetWiList2();//女法图片集合
            TaoistList2 = GetTaList2();//道士列表
        }

        /// <summary>
        /// 取外观武器
        /// </summary>
        /// <param name="sex"></param>
        /// <param name="iniFileHelper"></param>
        /// <returns></returns>
        public List<string> GetPersonWeaponPicture(IniFileHelper iniFileHelper)
        {
            List<string> list = new List<string>();

            string wqKey = iniFileHelper.Read("装备物品", "武器");//取武器

            if (!string.IsNullOrEmpty(wqKey) && wqKey != "0") // 根据不同的武器选择不同的外观
            {
                string std = iniFileHelper.Read("装备属性", wqKey);//取武器
                StditemDB stditemDB = Api.JsonDeserialize<StditemDB>(std);
                int shape = stditemDB.Shape * 1200;

                int n = 0;
                do
                {
                    list.Add(shape.ToString().PadLeft(6, '0') + ".png");
                    shape += 8;
                    n++;
                } while (n < 8);
            }
            return list;
        }

