                            rect = new Rectangle(705, 139, 60, 20);
                            DrawCenteredString(gh, user.User_General.PkPoint.ToString(), font8, brush, rect);//pk点数

                            rect = new Rectangle(605, 153, 60, 20);
                            DrawCenteredString(gh, user.User_General.Lv.ToString(), font8, brush, rect);//等级

