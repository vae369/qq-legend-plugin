                        }
                    }
                }
                return path;
            }
            catch (Exception ex)
            {
                throw ex;
            }
        }

        /// <summary>
        /// 查看装备
        /// </summary>
        public string GetEquipIMG(UserInfo user, int x = 0, int y = 0, int w = 0, int h = 0, int lv = 0)
        {
            try
            {
                string path = GamgeMainForm(user, true, true, true, x, y, w, h, lv);//获取生成游戏主窗体图

                using (Image imgMian = Image.FromFile(path))
                {
                    using (Bitmap bitmap = new Bitmap(imgMian.Width, imgMian.Height))
                    {
                        using (Graphics gh = Graphics.FromImage(bitmap))
                        {
                            gh.DrawImage(imgMian, 0, 0, bitmap.Width, bitmap.Height);//添加主窗体背景

                            #region 生成装备图
                            switch (user.Sex)
                            {
                                case "男":
                                    using (Image img = Image.FromFile(newopUIPath + "000088.png"))// 人物
                                    {
                                        int img02W = img.Width * 80 / 100;
                                        int img02H = img.Height * 80 / 100;
                                        gh.DrawImage(img, 505, 0, img02W, img02H);
                                    }
                                    break;
                                case "女":
                                    using (Image img = Image.FromFile(newopUIPath + "000087.png"))// 人物
                                    {
                                        int img02W = img.Width * 80 / 100;
                                        int img02H = img.Height * 80 / 100;
                                        gh.DrawImage(img, 505, 0, img02W, img02H);
                                    }
                                    break;
                                default: break;
                            }
                            Font font = new Font("黑体", 12);
                            Color color = ColorTranslator.FromHtml("#ffffff");
                            Brush brush = new SolidBrush(color);
                            Rectangle rect = new Rectangle(640, 70, 0, 0);
                            DrawCenteredString(gh, user.Name, font, brush, rect);//用户名

                            //查询出佩戴的装备，生成装备图片
                            path = UserPath + user.UserQQ + ".ini";
                            IniFileHelper iniFileHelper = new IniFileHelper(path);
                            List<string> listBwg = iniFileHelper.GetAllKeys("装备物品");

                            string zbbh = "";
                            StditemDB stditemDB = null;
                            foreach (string key in listBwg)
                            {
                                zbbh = iniFileHelper.Read("装备物品", key);
                                if (!string.IsNullOrEmpty(zbbh) && zbbh != "0")
                                {
                                    string std = iniFileHelper.Read("装备属性", zbbh);
                                    stditemDB = Api.JsonDeserialize<StditemDB>(std);
                                    newopUIPath = stateitemPath + stditemDB.StdImgPath;

                                    switch (key)
                                    {
                                        case "武器":
                                            using (Image img = Image.FromFile(newopUIPath))
                                            {
                                                int img02W = img.Width * 80 / 100;
                                                int img02H = img.Height * 80 / 100;
                                                gh.DrawImage(img, 590, 170, img.Width, img.Height);
                                            }
                                            break;
                                        case "衣服":
                                            using (Image img = Image.FromFile(newopUIPath))
                                            {
                                                int img02W = img.Width * 80 / 100;
                                                int img02H = img.Height * 80 / 100;
                                                gh.DrawImage(img, 611, 188, img02W, img02H);
                                            }
                                            break;
                                        case "右戒指":
                                            using (Image img = Image.FromFile(newopUIPath))
                                            {
                                                int img02W = img.Width * 80 / 100;
                                                int img02H = img.Height * 80 / 100;
                                                gh.DrawImage(img, 542, 282, img02W, img02H);
                                            }
                                            break;
                                        case "左戒指":
                                            using (Image img = Image.FromFile(newopUIPath))
                                            {
                                                int img02W = img.Width * 80 / 100;
                                                int img02H = img.Height * 80 / 100;
                                                gh.DrawImage(img, 735, 282, img02W, img02H);
                                            }
                                            break;
                                        case "右手镯":
                                            using (Image img = Image.FromFile(newopUIPath))
                                            {
                                                int img02W = img.Width * 80 / 100;
                                                int img02H = img.Height * 80 / 100;
                                                gh.DrawImage(img, 540, 244, img02W, img02H);
                                            }
                                            break;
                                        case "左手镯":
                                            using (Image img = Image.FromFile(newopUIPath))
                                            {
                                                int img02W = img.Width * 80 / 100;
                                                int img02H = img.Height * 80 / 100;
                                                gh.DrawImage(img, 734, 243, img02W, img02H);
                                            }
                                            break;
                                        case "项链":
                                            using (Image img = Image.FromFile(newopUIPath))
                                            {
                                                int img02W = img.Width * 80 / 100;
                                                int img02H = img.Height * 80 / 100;
                                                gh.DrawImage(img, 732, 210, img02W, img02H);
                                            }
                                            break;
                                    }
                                }
                            }
                            #endregion
                            path = $"{UserInfoImgPath + user.UserQQ}.png";
                            bitmap.Save(path, ImageFormat.Png);//保存图片
                        }
                    }
                }
                return path;
            }
            catch (Exception ex)
            {
                throw ex;
            }
        }
