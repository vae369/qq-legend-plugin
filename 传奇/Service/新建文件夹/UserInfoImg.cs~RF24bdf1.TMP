        /// <summary>
        /// 查看背包
        /// </summary>
        public string GetBWGIMG(UserInfo user, int x = 0, int y = 0, int w = 0, int h = 0, int lv = 0)
        {
            try
            {
                string path = GamgeMainForm(user, true, true, true, x, y, w, h, lv);//获取生成游戏主窗体图

                using (Image imgMian = Image.FromFile(path))
                {
                    using (Bitmap bitmap = new Bitmap(imgMian.Width, imgMian.Height))
                    {
                        using (Graphics gh = Graphics.FromImage(bitmap))
                        {
                            gh.CompositingQuality = CompositingQuality.HighQuality;
                            gh.DrawImage(imgMian, 0, 0, bitmap.Width, bitmap.Height);//添加主窗体背景

                            #region 生成背包图片

                            using (Image img = Image.FromFile(newopUIPath + "000002.png"))// 人物
                            {
                                gh.DrawImage(img, 5, 30, img.Width, img.Height);
                            }

                            Color color = ColorTranslator.FromHtml("#ffffff");
                            Brush brush = new SolidBrush(color);
                            //加载背包里的物品
                            Rectangle rect = new Rectangle(65, 310, 0, 0);
                            DrawLeftString(gh, user.User_General.JB.ToString(), fontBold8, brush, rect);//金币

                            rect = new Rectangle(70, 345, 0, 0);
                            DrawLeftString(gh, "  元宝：" + user.User_General.YB, fontBold8, brush, rect);//元宝

                            rect = new Rectangle(70, 365, 0, 0);
                            DrawLeftString(gh, "金刚石：" + user.User_General.JGS, fontBold8, brush, rect);//金刚石

                            int StdID = 0;
                            StditemDB stditemDB = null;

                            string newpath = UserPath + user.UserQQ + ".ini";
                            IniFileHelper iniFileHelper = new IniFileHelper(newpath);
                            List<string> listBwg = new List<string>();
                            listBwg = iniFileHelper.GetAllKeys("背包物品");

                            for (int i = 0; i < listBwg.Count; i++)
                            {
                                StdID = int.Parse(iniFileHelper.Read("背包物品", listBwg[i]));
                                stditemDB = stdDBList.Where(s => s.StdID == StdID).FirstOrDefault();
                                if (stditemDB != null)
                                {
                                    newpath = itemsPath + stditemDB.StdImgPath;

                                    List<string> humPos = FileHelper.ReadTxtReturnList(itemsPath + "Placements\\" + stditemDB.StdImgPath.Replace("png", "txt"));
                                    int humX = int.Parse(humPos[0]);
                                    int humY = int.Parse(humPos[1]);

                                    using (Image img = Image.FromFile(newpath))   //加载背包里的物品
                                    {
                                       
                                        switch (i)
                                        {
                                            case 0: gh.DrawImage(img, 30, 44, img.Width, img.Height); break;
                                            case 1: gh.DrawImage(img, 66, 44, img.Width, img.Height); break;
                                            case 2: gh.DrawImage(img, 102, 44, img.Width, img.Height); break;
                                            case 3: gh.DrawImage(img, 138, 44, img.Width, img.Height); break;
                                        }

                                    }
                                }
                            }

                            #endregion

                            path = $"{UserInfoImgPath + user.UserQQ}.jpg";
                            bitmap.Save(path, ImageFormat.Jpeg);//保存图片
                        }
                    }
                }
                return path;
            }
            catch (Exception ex)
            {
                throw ex;
            }
        }

        /// <summary>
        /// 卖肉
        /// </summary>
        public string GetSellingMeatIMG(UserInfo user, List<StditemDB> listResult, int x = 0, int y = 0, int w = 0, int h = 0, int lv = 0)
        {
            try
            {
                string path = GamgeMainForm(user, true, true, true, x, y, w, h, lv);//获取生成游戏主窗体图

                using (Image imgMian = Image.FromFile(path))
                {
                    using (Bitmap bitmap = new Bitmap(imgMian.Width, imgMian.Height))
                    {
                        using (Graphics gh = Graphics.FromImage(bitmap))
                        {
                            gh.DrawImage(imgMian, 0, 0, bitmap.Width, bitmap.Height);//添加主窗体背景

                            #region 生成卖肉对话框
                            using (Image img = Image.FromFile(prgusePath + "000360.png"))// 对话框
                            {
                                int img02W = img.Width * 75 / 100;
                                int img02H = img.Height * 75 / 100;
                                gh.DrawImage(img, 0, 0, img02W, img02H);
