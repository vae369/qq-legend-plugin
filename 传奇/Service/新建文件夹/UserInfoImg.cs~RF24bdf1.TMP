                            case 193: num = 208; break;
                            case 194: num = 216; break;
                            case 195: num = 224; break;
                            case 196: num = 232; break;
                            case 197: num = 240; break;
                            case 198: num = 248; break;
                            case 199: num = 256; break;
                            default: num = 200; break;
