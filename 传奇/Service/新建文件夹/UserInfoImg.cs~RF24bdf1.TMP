        public UserInfoImg(UserInfo user)
        {
            humPath = LegendIMGDataPath + "Hum\\";
            newopUIPath = LegendIMGDataPath + "NewopUI\\";
            itemsPath = LegendIMGDataPath + "Items\\";// 装备在背包的样子
