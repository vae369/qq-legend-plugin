        /// <summary>
        /// 查看属性
        /// </summary>
        public string GetUserAttributeIMG(UserInfo user, int x = 0, int y = 0, int w = 0, int h = 0, int lv = 0)
        {
            try
            {
                string path = GamgeMainForm(user, true, true, true, x, y, w, h, lv);//获取生成游戏主窗体图

                using (Image imgMian = Image.FromFile(path))
                {
                    using (Bitmap bitmap = new Bitmap(imgMian.Width, imgMian.Height))
                    {
                        using (Graphics gh = Graphics.FromImage(bitmap))
                        {
                            gh.DrawImage(imgMian, 0, 0, bitmap.Width, bitmap.Height);//添加主窗体背景

                            #region 生成属性图
                            Color color = ColorTranslator.FromHtml("#ffffff");
                            SolidBrush brush = new SolidBrush(color);
                            Rectangle rect;
                            Font font = new Font("黑体", 8, FontStyle.Bold);
                            using (Image img = Image.FromFile(newopUIPath + "000090.png"))// 状态
                            {
                                int img02W = img.Width * 80 / 100;
                                int img02H = img.Height * 80 / 100;
                                gh.DrawImage(img, 505, 0, img02W, img02H);
                            }

                            font = new Font("黑体", 12);
                            rect = new Rectangle(640, 70, 0, 0);
                            DrawCenteredString(gh, user.Name, font, brush, rect);//用户名

                            font = new Font("黑体", 8);
                            rect = new Rectangle(560, 136, 100, 10);
                            DrawCenteredString(gh, user.User_Attribute.Ac + "/" + user.User_Attribute.Ac2, font, brush, rect);//防御
                            rect = new Rectangle(560, 148, 100, 10);
