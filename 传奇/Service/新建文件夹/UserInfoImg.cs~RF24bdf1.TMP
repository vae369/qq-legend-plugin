        /// <summary>
        /// 查看称号
        /// </summary>
        public string GetUserTitleIMG(UserInfo user, int x = 0, int y = 0, int w = 0, int h = 0, int lv = 0)
        {
            try
            {
                string path = GamgeMainForm(user, false, true, true, x, y, w, h, lv);//获取生成游戏主窗体图

                using (Image imgMian = Image.FromFile(path))
                {
                    using (Bitmap bitmap = new Bitmap(imgMian.Width, imgMian.Height))
                    {
                        using (Graphics gh = Graphics.FromImage(bitmap))
                        {
                            gh.DrawImage(imgMian, 0, 0, bitmap.Width, bitmap.Height);//添加主窗体背景

                            #region 生成称号图
                            using (Image img = Image.FromFile(newopUIPath + "000094.png"))
                            {
                                int img02W = img.Width * 80 / 100;
                                int img02H = img.Height * 80 / 100;
                                gh.DrawImage(img, 505, 0, img02W, img02H);
                            }
                            Color color = ColorTranslator.FromHtml("#ffffff");
                            Brush brush = new SolidBrush(color);
                            Font font = new Font("黑体", 12);
                            Rectangle rect = new Rectangle(640, 70, 0, 0);
                            DrawCenteredString(gh, user.Name, font, brush, rect);//用户名
                            #endregion

                            path = $"{UserInfoImgPath + user.UserQQ}.png";
                            bitmap.Save(path, ImageFormat.Png);//保存图片
                        }
                    }
                }
                return path;
            }
            catch (Exception ex)
            {
                throw ex;
            }
        }

