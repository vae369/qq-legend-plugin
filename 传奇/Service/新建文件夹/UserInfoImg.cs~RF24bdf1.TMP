        /// <summary>
        /// 打怪方法
        /// </summary>
        /// <param name="user"></param>
        /// <param name="x"></param>
        /// <param name="y"></param>
        /// <param name="w"></param>
        /// <param name="h"></param>
        /// <param name="lv"></param>
        /// <returns></returns>
        public string GetAttackMonsterIMG(UserInfo user, int x = 0, int y = 0, int w = 0, int h = 0, int lv = 0)
        {
            try
            {

                StditemDB stditemDB = null;
                string path = "";
                double f = 0, n = 0;
                if (user.User_General.Lv < 7) // 小于7级随机找新手村一张地图刷怪
                {
                    if (user.MapCode == "1_0_1")
                    {
                        n = rnd.Next(1, 42);
                        user.UserImagePath = $"{LegendIMGDataPath}地图\\0\\银杏山谷\\{user.MapCode}_{n}.png";
                    }
                    else
                    {
                        n = rnd.Next(1, 33);
                        user.UserImagePath = $"{LegendIMGDataPath}地图\\0\\边界村\\{user.MapCode}_{n}.png";
                    }
                }
                else
                {
                    // 大于7级的找当前地图随即刷怪
                    switch (user.KillMon.MonID)
                    {
                        case 1://鸡
                            n = rnd.Next(1, 365);
                            break;
                        case 2:
                        case 3://鹿
                            n = rnd.Next(1, 365);
                            break;
                        case 4:
                        case 5://半兽人
                            n = rnd.Next(72, 85);
                            break;
                        case 11://毒蜘蛛
                            n = rnd.Next(7, 61);
                            break;
                        case 13:
                        case 14://蛤蟆
                            n = rnd.Next(300, 365);
                            break;
                        case 18:
                        case 19://森林雪人
                            n = rnd.Next(210, 333);
                            break;
                        case 35://多钩猫
                        case 36:
                            n = rnd.Next(44, 262);
                            break;
                        case 37://钉耙猫
                        case 38:
                            n = rnd.Next(44, 262);
                            break;
                        case 39:
                        case 40:
                        case 41://稻草人
                            n = rnd.Next(1, 200);
                            break;
                    }
                    user.UserImagePath = $"{LegendIMGDataPath}地图\\0\\城外\\{user.MapCode}_{n}.png";
                }

                #region 取人物动图
                MemoryStream ms = new MemoryStream();
                MagickImage magickImage = new MagickImage();
                Color color = ColorTranslator.FromHtml("#ffffff");
                Brush brush = new SolidBrush(color);
                Rectangle rect = new Rectangle(202, 472, 390, 15);
                string userIniPath = UserPath + user.UserQQ + ".ini";
                IniFileHelper iniFileHelper = new IniFileHelper(userIniPath);
                string hmPath = "", wpPath = "";
                var listPlayer = GetPlayerAttackPicture(user.Sex, iniFileHelper, false);

                var lastPlayerImg = listPlayer[listPlayer.Count - 1];
                listPlayer.RemoveAt(listPlayer.Count - 1);
                var personWeaponList = GetPersonWeaponPicture(iniFileHelper);
                #endregion

                #region 生成动画
                user.User_General.SumExp -= user.KillMon.Exp;
                string monStandPath = listMonsterStand[24];// 取往左站的图片
                using (var collection = new MagickImageCollection())
                {
                    path = GamgeMainForm(user, false, false, false, x, y, w, h, lv);//获取生成游戏主窗体图
                    int hpX1 = 500, hpY1 = 200, hpX2 = 510, hpY2 = 195, num = 0, resHp = 0, delay = 10, i = 0;

                    user.UserAttackRecordList.ForEach(userRecord =>
                    {
                        listPlayer.ForEach(p =>
                        {
                            using (Image imgMian = Image.FromFile(path))
                            {
                                using (Bitmap bitmap = new Bitmap(imgMian.Width, imgMian.Height))
                                {
                                    using (Graphics gh = Graphics.FromImage(bitmap))
                                    {
                                        gh.DrawImage(imgMian, 0, 0, bitmap.Width, bitmap.Height);//添加主窗体背景 

                                        using (Image player = Image.FromFile(monStandPath))// 设置怪物位置
                                        {
                                            gh.DrawImage(player, 445, 188, player.Width, player.Height);
                                        }

                                        using (Image img = Image.FromFile(newopUIPath + "000009.png"))// 怪物血条
                                        {
                                            gh.DrawImage(img, 465, 175, img.Width, img.Height);
                                        }
                                        using (Image img = Image.FromFile(newopUIPath + "000008.png"))// 怪物血条-掉血
                                        {
                                            if (resHp > 0)
                                                rect = new Rectangle(0, 0, resHp, img.Height);
                                            else
                                                rect = new Rectangle(0, 0, img.Width, img.Height);
                                            GraphicsUnit unit = GraphicsUnit.Pixel;
                                            gh.DrawImage(img, 465, 175, rect, unit);
                                        }
                                        rect = new Rectangle(475, 215, 0, 0);
                                        DrawCenteredString(gh, user.KillMon.MonName, font9, brush, rect);//怪物名

                                        // 取人物
                                        hmPath = humPath + p;
                                        using (Image player = Image.FromFile(hmPath))// 设置人物
                                        {
                                            gh.DrawImage(player, 400, 188, player.Width, player.Height);
                                        }
                                        if (personWeaponList.Count > 0)
                                        {
                                            wpPath = weaponPath + p;
                                            switch (i)
                                            {
                                                case 0:
                                                case 1:
                                                case 7:
                                                case 8:
                                                case 9:
                                                    using (Image player = Image.FromFile(wpPath))// 设置人物武器
                                                    {
                                                        gh.DrawImage(player, 418, 205, player.Width, player.Height);
                                                    }
                                                    break;
                                                case 2:
                                                    using (Image player = Image.FromFile(wpPath))// 设置人物武器
                                                    {
                                                        gh.DrawImage(player, 390, 185, player.Width, player.Height);
                                                    }
                                                    break;
                                                case 3:
                                                    using (Image player = Image.FromFile(wpPath))// 设置人物武器
                                                    {
                                                        gh.DrawImage(player, 384, 187, player.Width, player.Height);
                                                    }
                                                    break;
                                                case 4:
                                                    using (Image player = Image.FromFile(wpPath))// 设置人物武器
                                                    {
                                                        gh.DrawImage(player, 428, 202, player.Width, player.Height);
                                                    }
                                                    break;
                                                case 5:
                                                    using (Image player = Image.FromFile(wpPath))// 设置人物武器
                                                    {
                                                        gh.DrawImage(player, 445, 225, player.Width, player.Height);
                                                    }
                                                    break;
                                                case 6:
                                                    using (Image player = Image.FromFile(wpPath))// 设置人物武器
                                                    {
                                                        gh.DrawImage(player, 440, 220, player.Width, player.Height);
                                                    }
                                                    break;
                                            }
                                        }

                                        using (Image img = Image.FromFile(newopUIPath + "000008.png"))// 人物血条
                                        {
                                            gh.DrawImage(img, 396, 175, img.Width, img.Height);
                                        }

                                        rect = new Rectangle(405, 220, 0, 0);
                                        DrawCenteredString(gh, user.Name, font9, brush, rect);//用户名

                                        using (Image img = Image.FromFile(newopUIPath + "000017.png"))// 经验图
                                        {
                                            f = (double)user.User_General.SumExp / user.User_General.NextExp * 100;
                                            n = 72 * f / 100; //满经验72
                                            rect = new Rectangle(0, 0, (int)n, img.Height);
                                            GraphicsUnit unit = GraphicsUnit.Pixel;

                                            gh.DrawImage(img, 666, 528, rect, unit);
                                            rect = new Rectangle(745, 530, 0, 0);
                                            color = ColorTranslator.FromHtml("#ffffff");
                                            brush = new SolidBrush(color);
                                            DrawLeftString(gh, f.ToString("F2") + "%", fontBold8, brush, rect);//经验字
                                        }

                                        rect = new Rectangle(700, 521, 0, 0);
                                        DrawCenteredString(gh, user.User_General.SumExp.ToString(), fontBold10, brush, rect);//经验                                       
                                    }

                                    bitmap.Save(ms, ImageFormat.Png);
                                    ms.Seek(0, System.IO.SeekOrigin.Begin);
                                    magickImage = new MagickImage(ms);
                                    // 添加帧到GIF集合
                                    magickImage.AnimationDelay = delay; // 每帧延迟200毫秒
                                    collection.Add(magickImage);
                                }
                            }

                            i++;
                        });

                        #region 怪物挨打动画
                        i = 0;
                        listMonsterAttacked.ForEach(m =>
                        {
                            using (Image imgMian = Image.FromFile(path))
                            {
                                using (Bitmap bitmap = new Bitmap(imgMian.Width, imgMian.Height))
                                {
                                    using (Graphics gh = Graphics.FromImage(bitmap))
                                    {
                                        gh.DrawImage(imgMian, 0, 0, bitmap.Width, bitmap.Height);//添加主窗体背景

                                        using (Image mon = Image.FromFile(m))// 设置怪物位置
                                        {
                                            gh.DrawImage(mon, 445, 188, mon.Width, mon.Height);
                                        }

                                        using (Image img = Image.FromFile(newopUIPath + "000009.png"))// 怪物血条
                                        {
                                            gh.DrawImage(img, 465, 175, img.Width, img.Height);
                                        }

                                        using (Image img = Image.FromFile(newopUIPath + "000008.png"))// 怪物血条-掉血
                                        {
                                            f = (double)userRecord.uattack1 / user.KillMon.HP * 100;
                                            n = img.Width * f / 100; //满HP32
                                            if (num > 0)
                                                resHp = img.Width - (int)n - (img.Width - num);
                                            else
                                                resHp = img.Width - (int)n;
                                            if (resHp < 0) resHp = 0;
                                            rect = new Rectangle(0, 0, resHp, img.Height);
                                            GraphicsUnit unit = GraphicsUnit.Pixel;
                                            gh.DrawImage(img, 465, 175, rect, unit);
                                        }

                                        color = ColorTranslator.FromHtml("#ffffff");
                                        brush = new SolidBrush(color);
                                        rect = new Rectangle(475, 215, 0, 0);
                                        DrawCenteredString(gh, user.KillMon.MonName, font9, brush, rect);//怪物名
                                        using (Image player = Image.FromFile(hmPath))// 设置人物位置
                                        {
                                            gh.DrawImage(player, 400, 188, player.Width, player.Height);
                                        }
                                        if (personWeaponList.Count > 0)
                                        {
                                            using (Image player = Image.FromFile(wpPath))// 设置人物武器
                                            {
                                                gh.DrawImage(player, 418, 205, player.Width, player.Height);
                                            }
                                        }

                                        using (Image img = Image.FromFile(newopUIPath + "000008.png"))// 人物血条
                                        {
                                            gh.DrawImage(img, 396, 175, img.Width, img.Height);
                                        }

                                        rect = new Rectangle(405, 220, 0, 0);
                                        DrawCenteredString(gh, user.Name, font9, brush, rect);//用户名

                                        using (Image img = Image.FromFile(newopUIPath + "000060.png"))// 减号
                                        {
                                            gh.DrawImage(img, hpX1, hpY1 - (i * 5), img.Width, img.Height);
                                        }

                                        switch (userRecord.uattack1)
                                        {
                                            case 1:
                                                using (Image img = Image.FromFile(newopUIPath + "000051.png"))
                                                {
                                                    gh.DrawImage(img, hpX2, hpY2 - (i * 5), img.Width, img.Height);
                                                }
                                                break;
                                            case 2:
                                                using (Image img = Image.FromFile(newopUIPath + "000052.png"))
                                                {
                                                    gh.DrawImage(img, hpX2, hpY2 - (i * 5), img.Width, img.Height);
                                                }
                                                break;
                                            case 3:
                                                using (Image img = Image.FromFile(newopUIPath + "000053.png"))
                                                {
                                                    gh.DrawImage(img, hpX2, hpY2 - (i * 5), img.Width, img.Height);
                                                }
                                                break;
