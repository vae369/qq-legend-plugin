        /// <summary>
        /// 查看附近怪物
        /// </summary>
        /// <returns></returns>
        public string GetNearbyMonsterIMG(UserInfo user, int x = 0, int y = 0, int w = 0, int h = 0, int lv = 0)
        {
            try
            {
                string monPath = "";
                string path = "";
                if (user.User_General.Lv < 7)
                {
                    if (user.MapCode == "1_0_1")
                    {
                        user.UserImagePath = $"{LegendIMGDataPath}地图\\0\\银杏山谷\\{user.MapCode}_{rnd.Next(1, 42)}.png";
                    }
                    else
                    {
                        user.UserImagePath = $"{LegendIMGDataPath}地图\\0\\边界村\\{user.MapCode}_{rnd.Next(1, 33)}.png";
                    }
                    path = GamgeMainForm(user, true, true, true, x, y, w, h, lv);//获取生成游戏主窗体图

                }
                else
                {
                    user.UserImagePath = $"{LegendIMGDataPath}地图\\0\\城外\\{user.MapCode}_{rnd.Next(1, 365)}.png";
                    path = GamgeMainForm(user, false, true, true, x, y, w, h, lv);//获取生成游戏主窗体图
                }

                using (Image imgMian = Image.FromFile(path))
                {
                    using (Bitmap bitmap = new Bitmap(imgMian.Width, imgMian.Height))
                    {
                        using (Graphics gh = Graphics.FromImage(bitmap))
                        {
                            gh.DrawImage(imgMian, 0, 0, bitmap.Width, bitmap.Height);//添加主窗体背景

                            #region 添加附近怪物
                            string mapStr = FileHelper.ReadTxt(mapPath);
                            var mapInfoList = Api.JsonDeserialize<List<LengendMapInfo>>(mapStr);
                            var mapInfo = mapInfoList.Where(mp => mp.LMI_MapCode == user.MapCode).FirstOrDefault();

                            string mapMonStr = FileHelper.ReadTxt(mapMonInfo);
                            var legMapMons = Api.JsonDeserialize<List<LegMapMonInfo>>(mapMonStr);
                            legMapMons = legMapMons.Where(t => t.LMI_ID == mapInfo.LMI_ID).ToList();
                            LegMapMonInfo legMapMon = null;

                            int nd = rnd.Next(1, legMapMons.Count + 1);//随机获取当前地图的怪物,最少1种怪
                            Rectangle rect;
                            for (int i = 0; i < nd; i++)
                            {
                                int nnd = rnd.Next(1, 6);//随机生成刷几只
                                nnd = 1;
                                for (int j = 0; j < nnd; j++)
                                {
                                    legMapMon = legMapMons[i];
                                    var listMonStand = GetMonsterStandIMG(legMapMon.MonID);
                                    int nnnd = rnd.Next(1, listMonStand.Count);
                                    monPath = listMonStand[nnnd];

                                    int lmmx = rnd.Next(1, 745);
                                    int lmmy = rnd.Next(1, 315);
                                    using (Image img = Image.FromFile(monPath))// 刷怪
                                    {
                                        gh.DrawImage(img, lmmx, lmmy, img.Width, img.Height);
                                    }

                                    switch (legMapMon.MonID)
                                    {
                                        case 1:
                                            using (Image img = Image.FromFile(newopUIPath + "000008.png"))// 血条
                                            {
                                                gh.DrawImage(img, lmmx, lmmy - 30, img.Width, img.Height);
                                            }
                                            rect = new Rectangle(lmmx + 8, lmmy + 10, 0, 0);
                                            break;
                                        case 2:
                                        case 3:
                                            using (Image img = Image.FromFile(newopUIPath + "000008.png"))// 血条
                                            {
                                                gh.DrawImage(img, lmmx + 10, lmmy - 25, img.Width, img.Height);
                                            }
                                            rect = new Rectangle(lmmx + 15, lmmy + 22, 0, 0); break;
                                        case 39:
                                        case 40:
                                            using (Image img = Image.FromFile(newopUIPath + "000008.png"))// 血条
                                            {
                                                gh.DrawImage(img, lmmx + 10, lmmy - 23, img.Width, img.Height);
                                            }
                                            rect = new Rectangle(lmmx + 5, lmmy + 30, 0, 0); break;
                                        default:
                                            using (Image img = Image.FromFile(newopUIPath + "000008.png"))// 血条
                                            {
                                                gh.DrawImage(img, lmmx + 10, lmmy - 25, img.Width, img.Height);
                                            }
                                            rect = new Rectangle(lmmx + 15, lmmy + 22, 0, 0); break;
                                    }

                                    Font font = new Font("宋体", 10, FontStyle.Bold);
                                    SolidBrush brush = new SolidBrush(Color.GreenYellow);
                                    DrawLeftString(gh, legMapMon.MonName, font, brush, rect);//怪物名 
                                }
                            }
                            #endregion

                            path = $"{UserInfoImgPath + user.UserQQ}.png";
                            bitmap.Save(path, ImageFormat.Png);//保存图片
                        }
                    }

                }
                return path;
            }
            catch (Exception ex)
            {
                throw ex;
            }
        }

