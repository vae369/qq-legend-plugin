                            DrawCenteredString(gh, user.User_General.REP.ToString(), font8, brush, rect);//声望

                            rect = new Rectangle(605, 269, 60, 20);
                            DrawCenteredString(gh, user.User_General.JGS.ToString(), font8, brush, rect);//金刚石

                            rect = new Rectangle(605, 283, 60, 20);
                            DrawCenteredString(gh, user.User_General.Bgw + "/" + user.User_General.BgwMax, font8, brush, rect);//背包重量

                            rect = new Rectangle(605, 297, 60, 20);
