                            case 194: num = 408; break;
                            case 195: num = 416; break;
                            case 196: num = 424; break;
                            case 197: num = 432; break;
                            case 198: num = 440; break;
                            case 199: num = 448; break;
                            default: num = 392; break;
                        }
                    }
                    // 最后取一张站立不动的图片
                    lastNum = 16;
                }
                else
                {
                    num = rnd.Next(792, 800);
                    num = 794;
                    if (!isUseSkills)//是否使用技能
                    {
                        switch (num)//不使用技能，平砍图
                        {
                            case 792: num = 800; break;
                            case 793: num = 808; break;
                            case 794: num = 816; break;
                            case 795: num = 824; break;
                            case 796: num = 832; break;
                            case 797: num = 840; break;
                            case 798: num = 848; break;
                            case 799: num = 856; break;
                            default: num = 800; break;
                        }
                    }
                    else
                    {
                        switch (num)//使用技能图
                        {
                            case 792: num = 992; break;
                            case 793: num = 1000; break;
                            case 794: num = 1008; break;
                            case 795: num = 1016; break;
                            case 796: num = 1024; break;
                            case 797: num = 1032; break;
                            case 798: num = 1040; break;
                            case 799: num = 1048; break;
                            default: num = 992; break;
                        }
                    }
                    // 最后取一张站立不动的图片
                    lastNum = 616;
                }
                #endregion

            }

            list.Add(num.ToString().PadLeft(6, '0') + ".png");
            for (int i = num; i < num + 6; i++)
            {
                list.Add(i.ToString().PadLeft(6, '0') + ".png");
            }
            list.Add(num.ToString().PadLeft(6, '0') + ".png");
            list.Add(num.ToString().PadLeft(6, '0') + ".png");
            list.Add(lastNum.ToString().PadLeft(6, '0') + ".png");
            return list;
        }
